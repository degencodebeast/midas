# magic-agent-run.service — PAPER-ONLY poll loop (no real funds, no signing)
#
# THIS IS NOT THE LIVE UNIT. The canonical LIVE (twak) unit is
# deploy/midas-agent.service — it runs `--executor twak --live-frames --live-cmc`
# off /etc/midas/agent.env. Use THIS unit only for an offline/observe paper loop.
#
# CRITICAL — shared working directory:
#   magic-agent run WRITES .magic_agent/<mode>/status.json and
#   .magic_agent/<mode>/decisions.jsonl (paper => .magic_agent/paper/...).
#   magic-agent serve READS the same files to power /api/status and /api/decisions.
#   Both services MUST share the same WorkingDirectory (/opt/midas), and serve must be
#   pointed at the matching per-mode --status path (e.g. .magic_agent/paper/status.json).
#   Changing WorkingDirectory independently WILL break the serve API silently.
#
# Startup order: start the run loop and magic-agent-serve (any order, they share the
# working directory), then magic-agent-web, then your reverse proxy.

[Unit]
Description=magic-agent poll loop (PAPER executor — no funds)
After=network-online.target
Wants=network-online.target

[Service]
# Replace 'midas' with the OS user that owns /opt/midas (never run as root).
User=midas

# MUST match WorkingDirectory of magic-agent-serve.service so both processes
# share the same .magic_agent/ state directory.
WorkingDirectory=/opt/midas

# Load environment variables. Copy deploy/.env.example to /opt/midas/.env.
# (Paper mode requires NONE of the live secrets — they may stay as placeholders.)
EnvironmentFile=/opt/midas/.env

# PAPER executor only (simulated fills, no real funds, no signing). Add --live-frames
# and/or --live-cmc to scan the REAL Track-1 universe with no funds at risk. To trade
# LIVE, do NOT edit this unit — enable the canonical live unit deploy/midas-agent.service
# instead. Adjust the path to uv if it is installed elsewhere (run `which uv`).
ExecStart=/usr/local/bin/uv run magic-agent run --executor paper

Restart=on-failure
RestartSec=5

# Keep the .magic_agent/ directory across restarts (it is gitignored; must
# persist on disk — do not treat it as ephemeral tmpfiles).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magic-agent-run

[Install]
WantedBy=multi-user.target
