# magic-agent — deployment environment template
#
# Copy to .env at the repo root (the systemd EnvironmentFile points here):
#   cp deploy/.env.example /opt/midas/.env
# NEVER commit .env (it is gitignored). Placeholders only — fill with real values on the VPS.
#
# FORMAT: this file is consumed verbatim by systemd's `EnvironmentFile=`, which does NOT
# strip inline comments and treats everything after `=` as the value. So every comment
# lives on its OWN `#` line, and each setting is a clean `KEY=value` with NO trailing
# comment. (This also makes the file safe to `set -a; . .env; set +a` in a shell.)
#
# Run-loop tuning (symbol, risk, leverage, daily-loss kill-switch, advisor on/off, log
# path) is set via `magic-agent run` CLI FLAGS in the systemd unit, NOT here — this file
# holds secrets/credentials and integration config only.

# ── Aster (perp execution) — only needed for `--executor aster`; `paper` mode ignores these ──
# Wallet-signed (EIP-712) perp execution via ccxt.
# ASTER_PRIVATE_KEY: REQUIRED for --executor aster. Signing key. KEEP SECRET.
ASTER_PRIVATE_KEY=
# ASTER_WALLET_ADDRESS: wallet address (optional; some flows derive it from the key).
ASTER_WALLET_ADDRESS=
# ASTER_TESTNET: any NON-EMPTY value selects the Aster TESTNET base URL. Leave EMPTY for
# mainnet. (Do not put a comment on this line — a non-empty value silently picks testnet.)
ASTER_TESTNET=

# ── LLM advisor (bounded, OFF by default) — only consulted when `magic-agent run --advisor` is set ──
# Unset/empty => advisor DISABLED => pure deterministic path (the safe default).
# MAGIC_AGENT_LLM_API_KEY: Anthropic API key. Empty = advisor off.
MAGIC_AGENT_LLM_API_KEY=
# MAGIC_AGENT_LLM_MODEL: optional model id. Defaults to claude-sonnet-4-6 when empty.
MAGIC_AGENT_LLM_MODEL=

# ── ERC-8004 on-chain identity (OPTIONAL; needs the [identity] extra: `uv sync --extra identity`) ──
# HONEST STATUS: on-chain registration wiring is PENDING. Identity currently stays
# "unregistered" even with these set and the extra installed (cli._resolve_agent_id raises
# NotImplementedError -> None -> the dashboard shows "unregistered"; never a fabricated id).
# Of these three, ONLY MAGIC_AGENT_ERC8004_URI is read today (it gates the registration
# attempt); _RPC and _KEY are RESERVED for the pending registration adapter, not yet consumed.
# MAGIC_AGENT_ERC8004_URI: agent metadata URI. Empty = identity disabled (unregistered).
MAGIC_AGENT_ERC8004_URI=
# MAGIC_AGENT_ERC8004_RPC: (reserved — pending wiring) EVM RPC endpoint for registration.
MAGIC_AGENT_ERC8004_RPC=
# MAGIC_AGENT_ERC8004_KEY: (reserved — pending wiring) signing key for the registration tx. KEEP SECRET.
MAGIC_AGENT_ERC8004_KEY=

# ── CMC context (OPTIONAL; OBSERVE-ONLY) ──
# When MAGIC_AGENT_CMC_API_KEY is set, a real CMC client fetches + LOGS the Fear & Greed
# reading each context poll, but it runs OBSERVE-ONLY: it does NOT gate trades (it
# deliberately feeds a non-vetoing neutral/low context). Empty => context degrades to
# "unavailable" (full passthrough — no veto, no boost).
# MAGIC_AGENT_CMC_API_KEY: CoinMarketCap API key. Empty = context "unavailable".
MAGIC_AGENT_CMC_API_KEY=
# MAGIC_AGENT_CMC_BASE_URL: optional base-URL override. Defaults to https://pro-api.coinmarketcap.com
MAGIC_AGENT_CMC_BASE_URL=

# ── Dashboard / API ──
# NEXT_PUBLIC_API_BASE: browser-facing base URL the Next.js web app calls for /api/*
# (served by `magic-agent serve` behind the reverse proxy), e.g. https://your-domain.example.com/api
# BUILD-TIME: this is inlined into the web bundle at `npm run build` — set it BEFORE building
# the dashboard, and rebuild after any change (see deploy/README.md Step 4).
NEXT_PUBLIC_API_BASE=
