# magic-agent — deployment environment template
#
# Copy to .env at the repo root (the systemd EnvironmentFile points here):
#   cp deploy/.env.example /opt/midas/.env
# NEVER commit .env (it is gitignored). Placeholders only — fill with real values on the VPS.
#
# Run-loop tuning (symbol, risk, leverage, daily-loss kill-switch, advisor on/off, log path)
# is set via `magic-agent run` CLI FLAGS in the systemd unit, NOT here — this file holds
# secrets/credentials and integration config only.

# ── Aster (perp execution) — only needed for `--executor aster`; `paper` mode ignores these ──
# Wallet-signed (EIP-712) perp execution via ccxt.
ASTER_PRIVATE_KEY=           # REQUIRED for --executor aster. Signing key. KEEP SECRET.
ASTER_WALLET_ADDRESS=        # Wallet address (optional; some flows derive it from the key).
ASTER_TESTNET=               # Any non-empty value => use the Aster TESTNET base URL. Empty => mainnet.

# ── LLM advisor (bounded, OFF by default) — only consulted when `magic-agent run --advisor` is set ──
# Unset/empty => advisor DISABLED => pure deterministic path (the safe default).
MAGIC_AGENT_LLM_API_KEY=     # Anthropic API key. Unset = advisor off.
MAGIC_AGENT_LLM_MODEL=       # Optional model id. Defaults to claude-sonnet-4-6 when unset.

# ── ERC-8004 on-chain identity (OPTIONAL; needs the [identity] extra: `uv sync --extra identity`) ──
# HONEST STATUS: on-chain registration wiring is PENDING. Identity currently stays "unregistered"
# even with these set and the extra installed (cli._resolve_agent_id raises NotImplementedError
# -> None -> the dashboard shows "unregistered"; it never fabricates an id).
# Of these three, ONLY MAGIC_AGENT_ERC8004_URI is read today (it gates the registration attempt);
# _RPC and _KEY are RESERVED for the pending registration adapter and are not consumed yet.
MAGIC_AGENT_ERC8004_URI=     # Agent metadata URI. Unset = identity disabled (unregistered).
MAGIC_AGENT_ERC8004_RPC=     # (Reserved — pending wiring) EVM RPC endpoint for registration.
MAGIC_AGENT_ERC8004_KEY=     # (Reserved — pending wiring) signing key for the registration tx. KEEP SECRET.

# ── CMC context (OPTIONAL; OBSERVE-ONLY) ──
# When MAGIC_AGENT_CMC_API_KEY is set, a real CMC client fetches + LOGS the Fear & Greed reading
# each context poll, but it runs OBSERVE-ONLY: it does NOT gate trades (it deliberately feeds a
# non-vetoing neutral/low context). Unset => context degrades honestly to "unavailable".
MAGIC_AGENT_CMC_API_KEY=     # CoinMarketCap API key. Unset = context "unavailable".
MAGIC_AGENT_CMC_BASE_URL=    # Optional base-URL override. Defaults to https://pro-api.coinmarketcap.com

# ── Dashboard / API ──
# Browser-facing base URL the Next.js web app calls for /api/* (served by `magic-agent serve`
# behind the reverse proxy). E.g. https://your-domain.example.com/api
NEXT_PUBLIC_API_BASE=        # e.g. https://your-domain.example.com/api
